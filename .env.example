# NinjaOne API credentials
# Create them in NinjaOne: Administration > Apps > API > Client App IDs
# Recommended: Application platform "API Services (machine-to-machine)" with the
# "Client Credentials" grant - the server then gets and renews tokens on its own.
NINJA_CLIENT_ID=your_client_id
NINJA_CLIENT_SECRET=your_client_secret

# Your NinjaOne instance URL (the address you log in to), for example:
#   https://app.ninjarmm.com  (US)   https://ca.ninjarmm.com  (Canada)
#   https://eu.ninjarmm.com   (EU)   https://oc.ninjarmm.com  (Oceania)
NINJA_API_BASE_URL=https://app.ninjarmm.com

# Only needed for the optional browser login (node get-oauth-token.js)
NINJA_REDIRECT_URI=http://localhost:3000/callback

# Optional: where the server stores its renewed token (default: ./token.json)
# NINJA_TOKEN_FILE=
