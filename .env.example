# NinjaOne API Credentials
# Get these from your NinjaOne developer settings
NINJA_CLIENT_ID=your_access_key_id_here
NINJA_CLIENT_SECRET=your_secret_access_key_here
NINJA_REDIRECT_URI=https://yourdomain.com/callback

# Optional: NinjaOne API Base URL (defaults to https://api.ninjarmm.com)
NINJA_API_BASE_URL=https://api.ninjarmm.com

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info
